<script>
    const ADMIN_PIN = "1234";
    (function() {
        const PIN_STORAGE_KEY = 'mesa1_pin_verified';
        const PIN_TIMESTAMP_KEY = 'mesa1_pin_time';
        const MAX_SESSION_HOURS = 22;
        function hasActiveSession() {
            const verified = sessionStorage.getItem(PIN_STORAGE_KEY);
            const pinTime = sessionStorage.getItem(PIN_TIMESTAMP_KEY);
            if (verified === 'true' && pinTime) {
                const elapsed = Date.now() - parseInt(pinTime);
                const maxTime = MAX_SESSION_HOURS * 60 * 60 * 1000;
                if (elapsed < maxTime) {
                    sessionStorage.setItem(PIN_TIMESTAMP_KEY, Date.now().toString());
                    return true;
                }
            }
            return false;
        }
        function setVerifiedSession() {
            sessionStorage.setItem(PIN_STORAGE_KEY, 'true');
            sessionStorage.setItem(PIN_TIMESTAMP_KEY, Date.now().toString());
        }
        function showPinScreen() {
            document.body.innerHTML = `
                <div id="pin-overlay" style="
                    position: fixed;
                    top: 0; left: 0; width: 100%; height: 100%;
                    background: #0a0a1a;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    z-index: 99999;
                    gap: 20px;
                ">
                    <div style="
                        background: #16213e;
                        padding: 50px 40px;
                        border-radius: 20px;
                        border: 3px solid #e94560;
                        text-align: center;
                        max-width: 420px;
                        width: 90%;
                        box-shadow: 0 0 40px rgba(233, 69, 96, 0.3);
                    ">
                        <div style="font-size: 4em; margin-bottom: 15px;">🔐</div>
                        <h1 style="
                            color: #e94560;
                            margin-bottom: 10px;
                            font-size: 1.8em;
                            text-transform: uppercase;
                            letter-spacing: 2px;
                        ">ACCESO RESTRINGIDO</h1>
                        <p style="color: #888; margin-bottom: 30px; font-size: 1em;">
                            Ingresa el PIN de 4 dígitos para continuar
                        </p>
                        <div style="
                            display: flex;
                            gap: 12px;
                            justify-content: center;
                            margin-bottom: 25px;
                        ">
                            <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-input" id="pin1" style="
                                width: 60px; height: 70px;
                                background: #0a0a1a;
                                border: 3px solid #0f3460;
                                border-radius: 12px;
                                color: #e94560;
                                font-size: 2.2em;
                                font-weight: bold;
                                text-align: center;
                                outline: none;
                                transition: all 0.3s;
                                caret-color: transparent;
                                -webkit-text-security: disc;
                            ">
                            <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-input" id="pin2" style="
                                width: 60px; height: 70px;
                                background: #0a0a1a;
                                border: 3px solid #0f3460;
                                border-radius: 12px;
                                color: #e94560;
                                font-size: 2.2em;
                                font-weight: bold;
                                text-align: center;
                                outline: none;
                                transition: all 0.3s;
                                caret-color: transparent;
                                -webkit-text-security: disc;
                            ">
                            <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-input" id="pin3" style="
                                width: 60px; height: 70px;
                                background: #0a0a1a;
                                border: 3px solid #0f3460;
                                border-radius: 12px;
                                color: #e94560;
                                font-size: 2.2em;
                                font-weight: bold;
                                text-align: center;
                                outline: none;
                                transition: all 0.3s;
                                caret-color: transparent;
                                -webkit-text-security: disc;
                            ">
                            <input type="password" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-input" id="pin4" style="
                                width: 60px; height: 70px;
                                background: #0a0a1a;
                                border: 3px solid #0f3460;
                                border-radius: 12px;
                                color: #e94560;
                                font-size: 2.2em;
                                font-weight: bold;
                                text-align: center;
                                outline: none;
                                transition: all 0.3s;
                                caret-color: transparent;
                                -webkit-text-security: disc;
                            ">
                        </div>
                        <div id="pin-error" style="
                            color: #e74c3c;
                            font-size: 0.9em;
                            margin-bottom: 15px;
                            min-height: 20px;
                            font-weight: bold;
                            opacity: 0;
                            transition: opacity 0.3s;
                        ">PIN incorrecto. Intenta de nuevo.</div>
                        <button onclick="verifyPin()" style="
                            padding: 15px 50px;
                            background: #e94560;
                            color: #fff;
                            border: none;
                            border-radius: 10px;
                            font-size: 1.1em;
                            font-weight: bold;
                            cursor: pointer;
                            transition: all 0.3s;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            width: 100%;
                        " onmouseover="this.style.background='#c0392b'; this.style.transform='scale(1.02')" 
                        onmouseout="this.style.background='#e94560'; this.style.transform='scale(1)'">
                            🔓 DESBLOQUEAR
                        </button>
                        <div style="margin-top: 25px; padding-top: 20px; border-top: 1px solid #0f3460;">
                            <p style="color: #555; font-size: 0.75em; margin: 0;">
                                🔒 Sistema de seguridad activado<br>
                                Mesa 1 - Fernando Patiño
                            </p>
                        </div>
                    </div>
                </div>
            `;
            document.body.style.overflow = 'hidden';
            const style = document.createElement('style');
            style.textContent = `
                .pin-input:focus {
                    border-color: #e94560 !important;
                    box-shadow: 0 0 20px rgba(233, 69, 96, 0.6) !important;
                    transform: scale(1.08);
                }
                .pin-input.filled {
                    border-color: #2ecc71 !important;
                    background: rgba(46, 204, 113, 0.15) !important;
                }
                .pin-input.error {
                    border-color: #e74c3c !important;
                    background: rgba(231, 76, 60, 0.15) !important;
                    animation: shakePin 0.5s ease-in-out;
                }
                @keyframes shakePin {
                    0%, 100% { transform: translateX(0); }
                    20% { transform: translateX(-10px); }
                    40% { transform: translateX(10px); }
                    60% { transform: translateX(-5px); }
                    80% { transform: translateX(5px); }
                }
                @keyframes fadeIn {
                    from { opacity: 0; transform: translateY(-20px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                #pin-overlay > div {
                    animation: fadeIn 0.5s ease-out;
                }
            `;
            document.head.appendChild(style);
            setupPinInputs();
        }
        function setupPinInputs() {
            const inputs = document.querySelectorAll('.pin-input');
            inputs.forEach((input, index) => {
                input.addEventListener('keydown', (e) => {
                    if (e.key >= '0' && e.key <= '9') {
                        input.value = e.key;
                        input.classList.add('filled');
                        if (index < inputs.length - 1) {
                            inputs[index + 1].focus();
                        } else {
                            setTimeout(verifyPin, 150);
                        }
                        e.preventDefault();
                    } else if (e.key === 'Backspace') {
                        if (input.value === '' && index > 0) {
                            inputs[index - 1].focus();
                            inputs[index - 1].value = '';
                            inputs[index - 1].classList.remove('filled');
                        } else {
                            input.value = '';
                            input.classList.remove('filled');
                        }
                        e.preventDefault();
                    } else if (e.key === 'Enter') {
                        verifyPin();
                        e.preventDefault();
                    } else if (e.key === 'ArrowLeft' && index > 0) {
                        inputs[index - 1].focus();
                        e.preventDefault();
                    } else if (e.key === 'ArrowRight' && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                        e.preventDefault();
                    } else {
                        e.preventDefault();
                    }
                });
                input.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const pasteData = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 4);
                    if (pasteData) {
                        pasteData.split('').forEach((char, i) => {
                            if (inputs[i]) {
                                inputs[i].value = char;
                                inputs[i].classList.add('filled');
                            }
                        });
                        if (pasteData.length === 4) {
                            setTimeout(verifyPin, 200);
                        } else if (inputs[pasteData.length]) {
                            inputs[pasteData.length].focus();
                        }
                    }
                });
                input.addEventListener('contextmenu', (e) => e.preventDefault());
                if (index === 0) {
                    setTimeout(() => input.focus(), 200);
                }
            });
        }
        window.verifyPin = function() {
            const inputs = document.querySelectorAll('.pin-input');
            let enteredPin = '';
            inputs.forEach(input => {
                enteredPin += input.value;
            });
            const errorDiv = document.getElementById('pin-error');
            if (enteredPin === ADMIN_PIN) {
                inputs.forEach(input => {
                    input.style.borderColor = '#2ecc71';
                    input.style.background = 'rgba(46, 204, 113, 0.2)';
                    input.style.boxShadow = '0 0 15px rgba(46, 204, 113, 0.5)';
                });
                errorDiv.style.color = '#2ecc71';
                errorDiv.textContent = '✅ Acceso concedido. Cargando...';
                errorDiv.style.opacity = '1';
                setVerifiedSession();
                setTimeout(() => {
                    window.location.reload();
                }, 600);
            } else {
                inputs.forEach(input => {
                    input.classList.add('error');
                    input.value = '';
                    input.classList.remove('filled');
                });
                errorDiv.style.opacity = '1';
                setTimeout(() => {
                    inputs.forEach(input => input.classList.remove('error'));
                }, 500);
                setTimeout(() => {
                    if (inputs[0]) inputs[0].focus();
                }, 600);
            }
        };
        if (hasActiveSession()) {
            console.log('✅ Sesión PIN verificada');
            return;
        }
        showPinScreen();
        throw new Error('ESPERANDO_PIN');
    })();
    </script>

