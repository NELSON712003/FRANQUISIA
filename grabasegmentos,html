<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>
    <title>Mesa 2 - Sistema de Marcador con Transmision en Vivo</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #1a1a2e; color: #fff; overflow: hidden; height: 100vh; user-select: none; }
        .container { width: 100vw; height: 100vh; display: flex; flex-direction: column; padding: 10px; gap: 10px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: #16213e; padding: 10px 20px; border-radius: 10px; border: 2px solid #0f3460; }
        .header-left { display: flex; align-items: center; gap: 20px; }
        .header h1 { font-size: 1.5em; color: #e94560; display: flex; align-items: center; gap: 10px; }
        .live-indicator { color: #e74c3c; font-size: 0.6em; animation: blink 1s infinite; }
        .broadcast-status { display: flex; align-items: center; gap: 10px; background: rgba(231, 76, 60, 0.2); padding: 5px 15px; border-radius: 20px; border: 1px solid #e74c3c; }
        .broadcast-dot { width: 8px; height: 8px; background: #e74c3c; border-radius: 50%; animation: pulse 2s infinite; }
        .broadcast-text { font-size: 0.8em; color: #e74c3c; font-weight: bold; }
        .viewer-count { font-size: 0.75em; color: #aaa; margin-left: 10px; }
        .player-selector { display: flex; gap: 10px; align-items: center; }
        .btn-inicio-juego { padding: 10px 20px; border: none; border-radius: 8px; background: #2ecc71; color: #fff; cursor: pointer; font-size: 1em; font-weight: bold; transition: all 0.3s; text-transform: uppercase; }
        .btn-inicio-juego:hover { background: #27ae60; transform: scale(1.05); }
        .btn-player-count { padding: 10px 20px; border: none; border-radius: 8px; background: #0f3460; color: #fff; cursor: pointer; font-size: 1em; transition: all 0.3s; }
        .btn-player-count:hover, .btn-player-count.active { background: #e94560; transform: scale(1.05); }
        .main-content { flex: 1; display: flex; gap: 10px; min-height: 0; }
        .players-left, .players-right { display: flex; flex-direction: column; gap: 10px; width: 33.33%; min-width: 200px; }
        .player-card { background: #16213e; border-radius: 15px; padding: 15px; border: 3px solid #0f3460; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: space-between; position: relative; transition: all 0.3s; min-height: 0; height: 100%; max-height: 100%; }
        .player-card.active { border-color: #e94560; box-shadow: 0 0 20px rgba(233, 69, 96, 0.5); }
        .player-card.yellow-theme { background: #ffff5e; border-color: #d68910; color: #000; }
        .player-card.white-theme { background: linear-gradient(135deg, #ecf0f1, #bdc3c7); color: #000; border-color: #95a5a6; }
        .player-number { font-size: 1em; font-weight: bold; opacity: 0.8; align-self: flex-start; margin-bottom: 10px; }
        .player-card.yellow-theme .player-number { color: #000; }
        .player-card.white-theme .player-number { color: #000; }
        .score-display { flex: 1; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 0; }
        .player-score { font-size: 70px; font-weight: bold; cursor: pointer; transition: transform 0.1s; text-shadow: 2px 2px 4px rgba(0,0,0,0.3); user-select: none; }
        .player-card.yellow-theme .player-score { color: #000; text-shadow: 2px 2px 4px rgba(255,255,255,0.3); }
        .player-card.white-theme .player-score { color: #000; text-shadow: 2px 2px 4px rgba(255,255,255,0.3); }
        .player-score:active { transform: scale(0.95); }
        .score-controls { display: flex; gap: 8px; justify-content: center; width: 100%; margin-top: 15px; padding-top: 15px; border-top: 2px solid rgba(0,0,0,0.1); flex-shrink: 0; }
        .score-btn { flex: 1; min-width: 35px; height: 40px; border: none; border-radius: 8px; background: #0f3460; color: #fff; font-size: 1.2em; font-weight: bold; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .score-btn:hover { background: #e94560; transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.3); }
        .score-btn:active { transform: translateY(0); }
        .score-btn.add { background: #27ae60; }
        .score-btn.add:hover { background: #2ecc71; }
        .score-btn.subtract { background: #c0392b; }
        .score-btn.subtract:hover { background: #e74c3c; }
        .player-card.yellow-theme .score-btn { background: rgba(0,0,0,0.2); color: #000; }
        .player-card.yellow-theme .score-btn.add { background: rgba(39, 174, 96, 0.8); color: #fff; }
        .player-card.yellow-theme .score-btn.subtract { background: rgba(192, 57, 43, 0.8); color: #fff; }
        .player-card.white-theme .score-btn { background: rgba(0,0,0,0.1); color: #2c3e50; }
        .player-card.white-theme .score-btn.add { background: rgba(39, 174, 96, 0.8); color: #fff; }
        .player-card.white-theme .score-btn.subtract { background: rgba(192, 57, 43, 0.8); color: #fff; }
        .center-panel { width: 33.33%; min-width: 250px; display: flex; flex-direction: column; gap: 10px; position: relative; }
        .camera-container { flex: 1; background: #000; border-radius: 15px; overflow: hidden; position: relative; border: 3px solid #0f3460; min-height: 200px; display: flex; flex-direction: column; }
        .camera-feed { width: 100%; height: 100%; object-fit: cover; flex: 1; }
        .camera-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg, #1a1a2e, #16213e); color: #0f3460; font-size: 1.1em; text-align: center; padding: 20px; flex: 1; }
        .playback-controls-container { display: none !important; }
        .recording-indicator { display: none !important; }
        .camera-info { display: none; }
        .stats-panel { display: none; }
        .footer { display: flex; justify-content: space-between; align-items: center; background: #16213e; padding: 15px; border-radius: 10px; border: 2px solid #0f3460; gap: 20px; }
        .timer-section { display: none !important; }
        .timer-display { display: none !important; }
        .clock-display { display: none !important; }
        .controls-section { display: flex; gap: 15px; align-items: center; margin-left: auto; }
        .control-btn { padding: 8px 30px; border: none; border-radius: 10px; font-size: 1.1em; cursor: pointer; transition: all 0.3s; font-weight: bold; text-transform: uppercase; line-height: 1.2; }
        .btn-tiempo { display: none !important; }
        .btn-sound { background: #3498db; color: #fff; padding: 15px; border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; }
        .btn-sound.muted { background: #7f8c8d; }
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .modal-content { background: #16213e; padding: 40px; border-radius: 20px; border: 3px solid #e94560; text-align: center; max-width: 500px; }
        .modal-content h2 { margin-bottom: 20px; color: #e94560; }
        .modal-buttons { display: flex; gap: 20px; justify-content: center; margin-top: 30px; }
        .modal-btn { padding: 15px 40px; border: none; border-radius: 10px; font-size: 1.2em; cursor: pointer; transition: all 0.3s; }
        .modal-btn.yes { background: #27ae60; color: #fff; }
        .modal-btn.no { background: #e74c3c; color: #fff; }
        .modal-btn:hover { transform: scale(1.05); }
        .hidden { display: none !important; }
        @media (max-width: 1400px) { .player-score { font-size: 55px; } .score-btn { height: 35px; font-size: 1.1em; min-width: 30px; } }
        @media (max-width: 1200px) { .player-score { font-size: 45px; } .score-btn { height: 30px; font-size: 1em; min-width: 28px; } .center-panel { min-width: 200px; } }
        .player-card .player-score { font-size: 70px; }
        .two-players-mode .player-card .player-score { font-size: 180px !important; line-height: 1; }
        .two-players-mode .player-card { justify-content: center; }
        .two-players-mode .score-display { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0; }
        .two-players-mode .player-number { position: absolute; top: 15px; left: 15px; }
        .two-players-mode .score-controls { margin-top: auto; padding-top: 15px; }
        .fullscreen-btn { position: fixed; bottom: 20px; left: 20px; width: 50px; height: 50px; border-radius: 10px; background: #0f3460; border: 2px solid #3498db; color: #fff; font-size: 1.5em; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.3s; z-index: 100; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
        .fullscreen-btn:hover { background: #3498db; transform: scale(1.1); box-shadow: 0 6px 15px rgba(0,0,0,0.4); }
        .fullscreen-btn:active { transform: scale(0.95); }
        .camera-selector-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: none; align-items: center; justify-content: center; z-index: 2000; flex-direction: column; gap: 20px; }
        .camera-selector-overlay.active { display: flex; }
        .camera-selector-title { font-size: 1.5em; color: #e94560; margin-bottom: 10px; }
        .camera-list { display: flex; flex-direction: column; gap: 10px; max-width: 500px; width: 90%; max-height: 60vh; overflow-y: auto; }
        .camera-option { background: #16213e; border: 2px solid #0f3460; border-radius: 10px; padding: 15px; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 15px; }
        .camera-option:hover { border-color: #e94560; transform: translateX(5px); }
        .camera-option.selected { border-color: #2ecc71; background: rgba(46, 204, 113, 0.1); }
        .camera-option .camera-icon { font-size: 1.5em; }
        .camera-option .camera-info { flex: 1; }
        .camera-option .camera-name { font-weight: bold; color: #fff; }
        .camera-option .camera-type { font-size: 0.8em; color: #aaa; }
        .camera-option .camera-status { font-size: 0.75em; padding: 3px 10px; border-radius: 10px; background: #0f3460; }
        .camera-option .camera-status.wifi { background: #3498db; color: #fff; }
        .camera-option .camera-status.phone { background: #9b59b6; color: #fff; }
        .camera-option .camera-status.usb { background: #e67e22; color: #fff; }
        .btn-refresh-cameras { background: #3498db; color: #fff; border: none; padding: 10px 30px; border-radius: 8px; cursor: pointer; font-size: 1em; transition: all 0.3s; }
        .btn-refresh-cameras:hover { background: #2980b9; transform: scale(1.05); }
        .camera-preview { width: 120px; height: 80px; background: #000; border-radius: 5px; object-fit: cover; }
        .delay-indicator { position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.7); color: #e94560; padding: 5px 12px; border-radius: 15px; font-size: 0.75em; font-weight: bold; z-index: 10; border: 1px solid #e94560; }

        /* ====== SISTEMA DE REBOBINADO ====== */
        .replay-controls { position: absolute; bottom: 0; left: 0; width: 100%; background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 60%, transparent 100%); padding: 40px 15px 15px 15px; z-index: 20; display: flex; flex-direction: column; gap: 8px; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
        .camera-container:hover .replay-controls, .replay-controls.active { opacity: 1; pointer-events: all; }
        .replay-slider-container { display: flex; align-items: center; gap: 10px; width: 100%; }
        .replay-slider { flex: 1; -webkit-appearance: none; appearance: none; height: 8px; background: rgba(255,255,255,0.2); border-radius: 4px; outline: none; cursor: pointer; }
        .replay-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; background: #e94560; border-radius: 50%; cursor: pointer; border: 3px solid #fff; box-shadow: 0 0 10px rgba(233, 69, 96, 0.8); transition: transform 0.2s; }
        .replay-slider::-webkit-slider-thumb:hover { transform: scale(1.3); }
        .replay-slider::-moz-range-thumb { width: 20px; height: 20px; background: #e94560; border-radius: 50%; cursor: pointer; border: 3px solid #fff; box-shadow: 0 0 10px rgba(233, 69, 96, 0.8); }
        .replay-time-display { font-size: 0.85em; color: #fff; font-weight: bold; min-width: 80px; text-align: center; font-family: 'Courier New', monospace; background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 5px; }
        .replay-buttons { display: flex; gap: 10px; justify-content: center; align-items: center; }
        .replay-btn { padding: 8px 16px; border: none; border-radius: 8px; font-size: 0.85em; font-weight: bold; cursor: pointer; transition: all 0.3s; text-transform: uppercase; display: flex; align-items: center; gap: 5px; }
        .replay-btn-live { background: #e74c3c; color: #fff; }
        .replay-btn-live:hover { background: #c0392b; transform: scale(1.05); }
        .replay-btn-live.active { background: #27ae60; box-shadow: 0 0 15px rgba(39, 174, 96, 0.5); }
        .replay-btn-pause { background: #f39c12; color: #fff; }
        .replay-btn-pause:hover { background: #e67e22; transform: scale(1.05); }
        .replay-status { font-size: 0.75em; color: #e94560; text-align: center; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
        .replay-status.live { color: #2ecc71; }
        .replay-status.review { color: #f39c12; }
        .replay-status.paused { color: #f39c12; }
    </style>
