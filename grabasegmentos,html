<script>
        const BROADCASTER_ID = 'fernando-patino-mesa1-2024';
        const PEER_CONFIG = { host: '0.peerjs.com', port: 443, secure: true, debug: 1 };
        let playerCount = 2;
        let players = [];
        let soundEnabled = true;
        let stream = null;
        let currentCameraLabel = '';
        let currentDeviceId = null;
        let broadcastPeer = null;
        let activeCalls = new Map();
        let isBroadcasting = false;
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();

        // ============================================
        // SISTEMA DE GRABACION POR SEGMENTOS (REBOBINABLE)
        // Cada segmento es un archivo WebM independiente y seekable
        // ============================================

        let videoSegments = [];         // {blob, url, startTime, endTime, duration, id}
        const SEGMENT_DURATION = 2000;  // 2 segundos por segmento
        const MAX_SEGMENTS = 15;        // 30 segundos de buffer (15 x 2s)
        let currentSegmentIndex = 0;
        let segmentInterval = null;
        let globalStartTime = null;
        let mainMimeType = 'video/webm;codecs=vp8,opus';

        // MSE para retardo (modo vivo)
        let delayMediaSource = null;
        let delaySourceBuffer = null;
        let isMSEReady = false;
        const DELAY_MS = 10000;
        let mseQueue = [];

        // Estado del replay
        let replayMode = 'live';        // 'live', 'review', 'paused'
        let replayOffset = 0;           // ms hacia atras desde ahora
        let isDraggingSlider = false;
        let replayUpdateInterval = null;
        let currentReplayUrl = null;
        let currentSegmentUrl = null;

        const CAMERA_PRIORITY = { WIFI: 1, PHONE: 2, USB_OTG: 3, EXTERNAL: 4, INTERNAL: 5 };
        const CAMERA_KEYWORDS = {
            wifi: ['ip camera', 'network', 'wifi', 'wireless', 'rtsp', 'onvif', 'p2p', 'cloud', 'remote'],
            usb_otg: ['usb', 'otg', 'uvc', 'generic usb', 'usb camera', 'usb2.0', 'usb3.0'],
            external: ['hdmi', 'capture', 'cam link', 'elgato', 'avermedia', 'blackmagic', 'magewell', 'obs', 'virtual'],
            internal: ['integrated', 'built-in', 'internal', 'laptop', 'front', 'rear', 'faceTime', 'photo booth', 'snap']
        };

        function classifyCamera(label) {
            if (!label) return { type: 'unknown', priority: 99 };
            const lowerLabel = label.toLowerCase();
            for (const keyword of CAMERA_KEYWORDS.wifi) {
                if (lowerLabel.includes(keyword)) return { type: 'wifi', priority: CAMERA_PRIORITY.WIFI, label: 'WiFi/IP' };
            }
            for (const keyword of CAMERA_KEYWORDS.usb_otg) {
                if (lowerLabel.includes(keyword)) return { type: 'usb_otg', priority: CAMERA_PRIORITY.USB_OTG, label: 'USB/OTG' };
            }
            for (const keyword of CAMERA_KEYWORDS.external) {
                if (lowerLabel.includes(keyword)) return { type: 'external', priority: CAMERA_PRIORITY.EXTERNAL, label: 'HDMI/Capture' };
            }
            for (const keyword of CAMERA_KEYWORDS.internal) {
                if (lowerLabel.includes(keyword)) return { type: 'internal', priority: CAMERA_PRIORITY.INTERNAL, label: 'Interna' };
            }
            if (lowerLabel.includes('camera') || lowerLabel.includes('cam')) {
                return { type: 'external', priority: CAMERA_PRIORITY.EXTERNAL, label: 'Cámara' };
            }
            return { type: 'unknown', priority: 99, label: 'Desconocida' };
        }

        function getCameraIcon(type) {
            const icons = { wifi: '📡', phone: '📱', usb_otg: '🔌', external: '🎥', internal: '💻', unknown: '📷' };
            return icons[type] || '📷';
        }

        function playBeep(frequency = 800, duration = 200, type = 'square') {
            if (!soundEnabled) return;
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            oscillator.frequency.value = frequency;
            oscillator.type = type;
            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + duration / 1000);
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + duration / 1000);
        }

        function initPlayers() {
            players = [];
            for (let i = 1; i <= 6; i++) {
                players.push({ id: i, score: 0, active: i <= playerCount });
            }
            renderPlayers();
            const mainContent = document.querySelector('.main-content');
            if (playerCount === 2) {
                mainContent.classList.add('two-players-mode');
            } else {
                mainContent.classList.remove('two-players-mode');
            }
        }

        function renderPlayers() {
            const leftContainer = document.getElementById('playersLeft');
            const rightContainer = document.getElementById('playersRight');
            leftContainer.innerHTML = '';
            rightContainer.innerHTML = '';
            players.forEach((player) => {
                if (!player.active) return;
                const isLeft = player.id % 2 === 1;
                const theme = (player.id - 1) % 2 === 0 ? 'yellow-theme' : 'white-theme';
                const card = document.createElement('div');
                card.className = `player-card ${theme}`;
                card.innerHTML = `
                    <div class="player-number">Jugador ${player.id}</div>
                    <div class="score-display">
                        <div class="player-score" onclick="changeScore(${player.id}, 1)">${player.score}</div>
                    </div>
                    <div class="score-controls">
                        <button class="score-btn add" onclick="changeScore(${player.id}, 1)">+1</button>
                        <button class="score-btn add" onclick="changeScore(${player.id}, 2)">+2</button>
                        <button class="score-btn add" onclick="changeScore(${player.id}, 3)">+3</button>
                        <button class="score-btn add" onclick="changeScore(${player.id}, 4)">+4</button>
                        <button class="score-btn subtract" onclick="changeScore(${player.id}, -1)">-1</button>
                    </div>
                `;
                if (isLeft) {
                    leftContainer.appendChild(card);
