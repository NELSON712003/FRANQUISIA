        }

        function setPlayerCount(count) {
            playerCount = count;
            document.querySelectorAll('.btn-player-count').forEach((btn) => {
                const btnNumber = parseInt(btn.textContent);
                btn.classList.toggle('active', btnNumber === count);
            });
            initPlayers();
        }

        function changeScore(playerId, delta) {
            const player = players.find(p => p.id === playerId);
            if (!player) return;
            const newScore = player.score + delta;
            if (newScore >= 0 && newScore <= 300) {
                player.score = newScore;
                renderPlayers();
                playBeep(1000, 50, 'sine');
            }
        }

        async function getAvailableCameras() {
            try {
                await navigator.mediaDevices.getUserMedia({ video: true });
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(d => d.kind === 'videoinput');
                return videoDevices.map(device => {
                    const classification = classifyCamera(device.label);
                    return { deviceId: device.deviceId, label: device.label || 'Cámara sin nombre', ...classification };
                }).sort((a, b) => a.priority - b.priority);
            } catch (err) {
                console.error('Error enumerando cámaras:', err);
                return [];
            }
        }

        async function showCameraSelector() {
            const cameraList = document.getElementById('cameraList');
            const selector = document.getElementById('cameraSelector');
            cameraList.innerHTML = '<div style="text-align: center; color: #aaa; padding: 20px;">Buscando cámaras...</div>';
            selector.classList.add('active');
            const cameras = await getAvailableCameras();
            if (cameras.length === 0) {
                cameraList.innerHTML = '<div style="text-align: center; color: #e74c3c; padding: 20px;">No se encontraron cámaras</div>';
                return;
            }
            cameraList.innerHTML = cameras.map((cam, index) => `
                <div class="camera-option ${currentDeviceId === cam.deviceId ? 'selected' : ''}" 
                     onclick="selectCamera('${cam.deviceId}')">
                    <div class="camera-icon">${getCameraIcon(cam.type)}</div>
                    <div class="camera-info">
                        <div class="camera-name">${cam.label}</div>
                        <div class="camera-type">Prioridad: ${cam.priority} - ${cam.label}</div>
                    </div>
                    <div class="camera-status ${cam.type}">${cam.label}</div>
                </div>
            `).join('');
        }

        function closeCameraSelector() {
            document.getElementById('cameraSelector').classList.remove('active');
        }

        function refreshCameraList() {
            showCameraSelector();
        }

        async function selectCamera(deviceId) {
            closeCameraSelector();
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
            }
            stopAllSystems();
            try {
                const constraints = {
                    video: { deviceId: { exact: deviceId }, width: { ideal: 1280 }, height: { ideal: 720 } },
                    audio: true
                };
                stream = await navigator.mediaDevices.getUserMedia(constraints);
                currentDeviceId = deviceId;
                const video = document.getElementById('cameraFeed');
                video.srcObject = stream;
                document.getElementById('cameraPlaceholder').classList.add('hidden');
                video.classList.remove('hidden');
                const devices = await navigator.mediaDevices.enumerateDevices();
                const device = devices.find(d => d.deviceId === deviceId);
                currentCameraLabel = device ? device.label : 'Cámara seleccionada';
                console.log('✅ Cámara conectada:', currentCameraLabel);
                playBeep(800, 100, 'sine');
                setTimeout(() => startSegmentedRecording(), 500);
                restartBroadcast();
            } catch (err) {
                console.error('Error conectando cámara:', err);
                alert('Error al conectar la cámara: ' + err.message);
            }
        }

        async function findAndConnectCamera() {
            console.log('🔍 Buscando cámaras con prioridad...');
            try {
                const cameras = await getAvailableCameras();
                if (cameras.length === 0) {
                    console.log('❌ No se encontraron cámaras');
                    document.getElementById('placeholderText').textContent = 'No hay cámaras disponibles';
                    return;
                }
                console.log(`📹 ${cameras.length} cámara(s) encontrada(s)`);
                cameras.forEach((cam, i) => {
                    console.log(`  ${i+1}. ${cam.label} [${cam.label}]`);
                });
                for (const camera of cameras) {
                    try {
                        console.log(`🎥 Intentando conectar: ${camera.label}`);
                        const constraints = {
                            video: { deviceId: { exact: camera.deviceId }, width: { ideal: 1280 }, height: { ideal: 720 } },
                            audio: true
                        };
                        stream = await navigator.mediaDevices.getUserMedia(constraints);
                        const video = document.getElementById('cameraFeed');
                        video.srcObject = stream;
                        document.getElementById('cameraPlaceholder').classList.add('hidden');
                        video.classList.remove('hidden');
                        currentDeviceId = camera.deviceId;
                        currentCameraLabel = camera.label;
                        console.log('✅ Cámara conectada:', currentCameraLabel);
                        playBeep(800, 100, 'sine');
                        setTimeout(() => startSegmentedRecording(), 1000);
                        setTimeout(initBroadcastPeerJS, 1500);
                        return;
                    } catch (err) {
                        console.log(`⚠️ Error con ${camera.label}:`, err.message);
                        continue;
                    }
                }
                document.getElementById('placeholderText').textContent = 'No se pudo conectar ninguna cámara';
            } catch (err) {
                console.error('❌ Error general:', err);
                document.getElementById('placeholderText').textContent = 'Error de acceso a cámaras';
            }
        }

        function restartBroadcast() {
            if (broadcastPeer) {
                broadcastPeer.destroy();
                broadcastPeer = null;
                activeCalls.clear();
            }
            setTimeout(initBroadcastPeerJS, 500);
        }

        // ============================================
        // SISTEMA DE GRABACION POR SEGMENTOS (REBOBINABLE)
        // Cada segmento es un archivo WebM independiente y seekable
        // ============================================

        function startSegmentedRecording() {
            if (!stream) {
                console.error('❌ No hay stream para grabar');
                return;
            }
            console.log('📼 Iniciando grabación por segmentos...');
            stopSegmentedRecording();

            videoSegments = [];
            globalStartTime = Date.now();
            currentSegmentIndex = 0;

            // Detectar mejor mimeType
            let mime = 'video/webm;codecs=vp9,opus';
            if (!MediaRecorder.isTypeSupported(mime)) {
                mime = 'video/webm;codecs=vp8,opus';
                if (!MediaRecorder.isTypeSupported(mime)) {
                    mime = 'video/webm';
                }
            }
            mainMimeType = mime;

            // Iniciar primer segmento inmediatamente
            startNewSegment();

            // Crear siguiente segmento cada 2 segundos
            segmentInterval = setInterval(() => {
                if (!stream) return;
                startNewSegment();
            }, SEGMENT_DURATION);

            // Iniciar MSE para retardo
            setTimeout(() => startMSEDelay(), 100);

            console.log('✅ Grabación por segmentos iniciada');
        }

        function startNewSegment() {
            // Si hay demasiados segmentos, eliminar el más antiguo
            if (videoSegments.length >= MAX_SEGMENTS) {
                const old = videoSegments.shift();
                if (old && old.url) URL.revokeObjectURL(old.url);
            }

            const segmentId = currentSegmentIndex++;
            const segmentStart = Date.now();

            // Clonar el stream para este segmento (cada segmento es independiente)
            const clonedStream = stream.clone();

            const recorder = new MediaRecorder(clonedStream, {
                mimeType: mainMimeType,
                audioBitsPerSecond: 128000,
                videoBitsPerSecond: 2500000
            });

            const chunks = [];

            recorder.ondataavailable = (e) => {
                if (e.data && e.data.size > 0) {
                    chunks.push(e.data);
                }
            };

            recorder.onstop = () => {
                // Este blob es un archivo WebM COMPLETO e independiente
                const blob = new Blob(chunks, { type: mainMimeType });
                const url = URL.createObjectURL(blob);

                const segment = {
                    id: segmentId,
                    blob: blob,
                    url: url,
                    startTime: segmentStart,
                    endTime: Date.now(),
                    duration: Date.now() - segmentStart,
                    mimeType: mainMimeType,
                    _mseProcessed: false
                };

                videoSegments.push(segment);

                // Detener tracks del stream clonado para liberar memoria
                clonedStream.getTracks().forEach(t => t.stop());

                console.log(`📹 Segmento #${segmentId} grabado: ${segment.duration}ms`);
            };

            recorder.onerror = (err) => {
                console.error(`❌ Error segmento #${segmentId}:`, err);
                clonedStream.getTracks().forEach(t => t.stop());
            };

            // Grabar por exactamente 2 segundos
            recorder.start();
            setTimeout(() => {
                if (recorder.state !== 'inactive') {
                    recorder.stop();
                }
            }, SEGMENT_DURATION);
        }

        function stopSegmentedRecording() {
            if (segmentInterval) {
                clearInterval(segmentInterval);
                segmentInterval = null;
            }

            // Limpiar URLs de segmentos
            videoSegments.forEach(seg => {
                if (seg.url) URL.revokeObjectURL(seg.url);
            });
            videoSegments = [];

            stopMSEDelay();

            console.log('⏹ Grabación por segmentos detenida');
        }

        // ============================================
        // MSE PARA RETARDO (modo vivo)
        // ============================================

        function startMSEDelay() {
            if (!window.MediaSource) {
                console.warn('⚠️ MediaSource no soportado');
                return;
            }

            const mimeType = 'video/webm; codecs="vp8,opus"';
            if (!MediaSource.isTypeSupported(mimeType)) {
                console.warn('⚠️ MSE no soporta VP8');
                return;
            }

            try {
                delayMediaSource = new MediaSource();
                delayMediaSource.addEventListener('sourceopen', () => onMSEOpen(mimeType));

                const delayedVideo = document.getElementById('delayedVideo');
                delayedVideo.src = URL.createObjectURL(delayMediaSource);
                document.getElementById('delayIndicator').style.display = 'block';
            } catch (err) {
                console.error('❌ Error MSE:', err);
            }
        }

        function onMSEOpen(finalMime) {
            try {
                delaySourceBuffer = delayMediaSource.addSourceBuffer(finalMime);
                delaySourceBuffer.mode = 'sequence';
                delaySourceBuffer.addEventListener('updateend', () => processMSEQueue());
                isMSEReady = true;
                console.log('✅ SourceBuffer listo');
            } catch (err) {
                console.error('❌ Error SourceBuffer:', err);
            }
        }

        function processMSEQueue() {
            if (!isMSEReady || !delaySourceBuffer || delaySourceBuffer.updating) return;
            if (replayMode !== 'live') return;

            const playTime = Date.now() - DELAY_MS;
            const readySegments = videoSegments.filter(seg => seg.endTime <= playTime && !seg._mseProcessed);

            if (readySegments.length === 0) return;

            // Tomar el segmento más antiguo no procesado
            const segment = readySegments[0];
            segment._mseProcessed = true;

            const reader = new FileReader();
            reader.onload = () => {
                try {
                    if (delaySourceBuffer && !delaySourceBuffer.updating && replayMode === 'live') {
                        delaySourceBuffer.appendBuffer(reader.result);
                    }
                } catch (e) {
                    console.error('❌ Error appendBuffer:', e.message);
                }
            };
            reader.readAsArrayBuffer(segment.blob);
        }

        function stopMSEDelay() {
            isMSEReady = false;
            if (delayMediaSource && delayMediaSource.readyState === 'open') {
                try { delayMediaSource.endOfStream(); } catch(e) {}
            }
            delayMediaSource = null;
            delaySourceBuffer = null;
            document.getElementById('delayIndicator').style.display = 'none';
        }

        // ============================================
        // SISTEMA DE REBOBINADO (CORREGIDO)
        // Ahora usa segmentos independientes que SÍ se pueden reproducir
        // ============================================

        function initReplaySystem() {
            const slider = document.getElementById('replaySlider');

            slider.addEventListener('input', (e) => {
                isDraggingSlider = true;
                const value = parseFloat(e.target.value);
                updateReplayFromSlider(value);
            });

            slider.addEventListener('change', (e) => {
                isDraggingSlider = false;
                const value = parseFloat(e.target.value);
                if (value >= 99) {
                    goToLive();
                } else {
                    updateReplayFromSlider(value);
                }
            });

            // Loop de actualización
            replayUpdateInterval = setInterval(() => {
                if (replayMode === 'live') {
                    updateReplayUI();
                }
            }, 500);
        }

        function updateReplayFromSlider(value) {
            // value: 0 = máximo hacia atrás (30s), 100 = en vivo
            const maxOffset = MAX_SEGMENTS * SEGMENT_DURATION;
            replayOffset = Math.round((100 - value) / 100 * maxOffset);

            if (replayOffset <= 1000) {
                goToLive();
                return;
            }

            replayMode = 'review';
            renderReplayFrame();
            updateReplayUI();
        }

        function renderReplayFrame() {
            if (videoSegments.length === 0) {
                console.warn('⚠️ No hay segmentos en buffer');
                return;
            }

            const targetTime = Date.now() - replayOffset;

            // Encontrar el segmento que contiene este tiempo
            const segment = videoSegments.find(seg => 
                seg.startTime <= targetTime && seg.endTime >= targetTime
            );

            if (!segment) {
                // Si no hay segmento exacto, usar el más cercano
                const closest = videoSegments.reduce((prev, curr) => {
                    return Math.abs(curr.startTime - targetTime) < Math.abs(prev.startTime - targetTime) 
                        ? curr : prev;
                });
                if (closest) {
                    playSegment(closest, 0);
                }
                return;
            }

            // Calcular offset dentro del segmento
            const offsetInSegment = targetTime - segment.startTime;
            playSegment(segment, offsetInSegment);
        }

        function playSegment(segment, offsetMs) {
            const delayedVideo = document.getElementById('delayedVideo');

            // Limpiar URL anterior de replay
            if (currentReplayUrl && currentReplayUrl !== segment.url) {
                URL.revokeObjectURL(currentReplayUrl);
            }

            // Usar el blob del segmento directamente (es un archivo válido)
            currentReplayUrl = segment.url;
            delayedVideo.src = currentReplayUrl;

            delayedVideo.onloadedmetadata = () => {
                // Saltar al offset deseado dentro del segmento
                const seekTime = offsetMs / 1000;
                if (seekTime > 0 && seekTime < delayedVideo.duration) {
                    delayedVideo.currentTime = seekTime;
                }
                delayedVideo.play().then(() => {
                    console.log(`▶️ Reproduciendo segmento #${segment.id} @ ${(offsetMs/1000).toFixed(1)}s`);
                }).catch(err => {
                    console.error('❌ Error reproduciendo:', err);
                });
            };
        }

        function goToLive() {
            if (replayMode === 'live') return;

            console.log('🔴 Volviendo a EN VIVO...');
            replayMode = 'live';
            replayOffset = 0;

            // Limpiar URL de replay
            if (currentReplayUrl) {
                URL.revokeObjectURL(currentReplayUrl);
                currentReplayUrl = null;
            }

            // Restaurar MSE
            const delayedVideo = document.getElementById('delayedVideo');
            delayedVideo.pause();
            delayedVideo.removeAttribute('src');
            delayedVideo.load();

            stopMSEDelay();
            setTimeout(() => startMSEDelay(), 100);

            updateReplayUI();
            playBeep(1000, 100, 'sine');
        }

        function toggleReplayPause() {
            const btn = document.getElementById('btnPause');
            const delayedVideo = document.getElementById('delayedVideo');

            if (replayMode === 'paused') {
                replayMode = 'review';
                delayedVideo.play().catch(() => {});
                btn.innerHTML = '⏸️ PAUSAR';
            } else if (replayMode === 'review') {
                replayMode = 'paused';
                delayedVideo.pause();
                btn.innerHTML = '▶️ REANUDAR';
            } else {
                stepBackward();
            }
            updateReplayUI();
        }

        function stepBackward() {
            if (replayMode === 'live') {
                replayMode = 'review';
            }
            const maxOffset = MAX_SEGMENTS * SEGMENT_DURATION;
            replayOffset = Math.min(replayOffset + 5000, maxOffset);

            const slider = document.getElementById('replaySlider');
            slider.value = Math.max(0, 100 - (replayOffset / maxOffset * 100));

            renderReplayFrame();
            updateReplayUI();
            playBeep(800, 50, 'sine');
        }

        function stepForward() {
            const maxOffset = MAX_SEGMENTS * SEGMENT_DURATION;
            replayOffset = Math.max(replayOffset - 5000, 0);

            if (replayOffset <= 1000) {
                goToLive();
                return;
            }

            const slider = document.getElementById('replaySlider');
            slider.value = Math.max(0, 100 - (replayOffset / maxOffset * 100));

            renderReplayFrame();
            updateReplayUI();
            playBeep(800, 50, 'sine');
        }

        function updateReplayUI() {
            const statusEl = document.getElementById('replayStatus');
            const timeEl = document.getElementById('replayTime');
            const btnLive = document.getElementById('btnLive');
            const slider = document.getElementById('replaySlider');
            const maxOffset = MAX_SEGMENTS * SEGMENT_DURATION;

            if (replayMode === 'live') {
                statusEl.textContent = '● EN VIVO';
                statusEl.className = 'replay-status live';
                timeEl.textContent = '-0s';
                btnLive.classList.add('active');
                btnLive.innerHTML = '🔴 EN VIVO';
                if (!isDraggingSlider) slider.value = 100;
            } else if (replayMode === 'paused') {
                statusEl.textContent = '⏸️ PAUSADO';
                statusEl.className = 'replay-status paused';
                timeEl.textContent = `-${Math.round(replayOffset / 1000)}s`;
                btnLive.classList.remove('active');
                btnLive.innerHTML = '🔴 EN VIVO';
                if (!isDraggingSlider) slider.value = Math.max(0, 100 - (replayOffset / maxOffset * 100));
            } else {
                statusEl.textContent = '◀ REVISANDO';
                statusEl.className = 'replay-status review';
                timeEl.textContent = `-${Math.round(replayOffset / 1000)}s`;
                btnLive.classList.remove('active');
                btnLive.innerHTML = '🔴 EN VIVO';
                if (!isDraggingSlider) slider.value = Math.max(0, 100 - (replayOffset / maxOffset * 100));
            }
        }

        function stopAllSystems() {
            stopSegmentedRecording();

            if (currentReplayUrl) {
                URL.revokeObjectURL(currentReplayUrl);
                currentReplayUrl = null;
            }

            replayMode = 'live';
            replayOffset = 0;
            isDraggingSlider = false;

            const delayedVideo = document.getElementById('delayedVideo');
            if (delayedVideo) {
                delayedVideo.pause();
                delayedVideo.removeAttribute('src');
                delayedVideo.load();
            }

            console.log('🛑 Todos los sistemas detenidos');
        }

        // ============================================
        // PEERJS BROADCAST
        // ============================================
        function initBroadcastPeerJS() {
            if (!stream) {
                console.error('❌ No hay stream disponible para transmitir');
                return;
            }
            if (broadcastPeer) {
                console.log('🔄 Broadcast ya inicializado');
                return;
            }
            console.log('📡 Iniciando PeerJS Broadcast con ID:', BROADCASTER_ID);
            broadcastPeer = new Peer(BROADCASTER_ID, PEER_CONFIG);
            broadcastPeer.on('open', (id) => {
                console.log('✅ Broadcaster conectado con ID:', id);
                isBroadcasting = true;
                document.getElementById('broadcastStatus').style.display = 'flex';
                updateViewerCount();
                playBeep(1000, 200, 'sine');
            });
            broadcastPeer.on('call', (call) => {
                console.log('📞 Nuevo espectador conectándose:', call.peer);
                call.answer(stream);
                activeCalls.set(call.peer, call);
                console.log(`✅ Espectador conectado. Total: ${activeCalls.size}`);
                updateViewerCount();
                playBeep(1200, 100, 'sine');
                call.on('stream', (remoteStream) => {
                    console.log('📥 Stream recibido del viewer (no esperado)');
                });
                call.on('close', () => {
                    console.log('❌ Espectador desconectado:', call.peer);
                    activeCalls.delete(call.peer);
                    updateViewerCount();
                });
                call.on('error', (err) => {
                    console.error('❌ Error en llamada:', err);
                    activeCalls.delete(call.peer);
                    updateViewerCount();
                });
            });
            broadcastPeer.on('error', (err) => {
                console.error('❌ Error PeerJS:', err);
                if (err.type === 'unavailable-id') {
                    console.log('⚠️ ID en uso, intentando con ID alternativo...');
                    setTimeout(() => {
                        broadcastPeer.destroy();
                        broadcastPeer = null;
                        const altId = BROADCASTER_ID + '-' + Date.now();
                        console.log('🔄 Intentando con ID:', altId);
                    }, 2000);
                } else if (err.type === 'network' || err.type === 'disconnected') {
                    console.log('🔄 Reconectando en 3 segundos...');
                    setTimeout(() => {
                        if (broadcastPeer) {
                            broadcastPeer.reconnect();
                        }
                    }, 3000);
                }
            });
            broadcastPeer.on('disconnected', () => {
                console.log('⚠️ Desconectado del servidor PeerJS');
                isBroadcasting = false;
                document.getElementById('broadcastStatus').style.display = 'none';
                setTimeout(() => {
                    if (broadcastPeer && !broadcastPeer.destroyed) {
                        console.log('🔄 Reconectando...');
                        broadcastPeer.reconnect();
                    }
                }, 2000);
            });
            broadcastPeer.on('close', () => {
                console.log('🔌 Peer cerrado');
                isBroadcasting = false;
                broadcastPeer = null;
                activeCalls.clear();
                document.getElementById('broadcastStatus').style.display = 'none';
            });
        }

        function updateViewerCount() {
            const count = activeCalls.size;
            const viewerCountEl = document.getElementById('viewerCount');
            viewerCountEl.textContent = `${count} espectador${count !== 1 ? 'es' : ''}`;
            if (count > 0) {
                document.title = `🏆 MESA 1 (${count} viendo) - Marcador`;
            } else {
                document.title = '🏆 MESA 1 - Marcador con Transmisión';
            }
        }

        function getConnectedViewers() {
            return activeCalls.size;
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const btn = document.getElementById('soundBtn');
            btn.textContent = soundEnabled ? '🔊' : '🔇';
            btn.classList.toggle('muted', !soundEnabled);
        }

        function showResetModal() {
            document.getElementById('resetModal').classList.add('active');
        }

        function hideResetModal() {
            document.getElementById('resetModal').classList.remove('active');
        }

        function confirmResetFromHeader() {
            showResetModal();
        }

        function confirmReset() {
            // Reset puntos
            players.forEach(p => p.score = 0);
            renderPlayers();

            // === RESET COMPLETO DE VIDEO ===
            // 1. Detener TODO (grabación, MSE, replay)
            stopAllSystems();

            // 2. Esperar y reiniciar grabación desde CERO
            setTimeout(() => {
                if (stream) {
                    console.log('🔄 Reiniciando grabación desde cero...');
                    startSegmentedRecording();
                }
            }, 300);

            hideResetModal();
            playBeep(600, 200);
            console.log('🔄 Juego reiniciado - Grabación nueva iniciada');
        }

        async function init() {
            initPlayers();
            initReplaySystem();
            setTimeout(findAndConnectCamera, 500);
            navigator.mediaDevices.addEventListener('devicechange', () => {
                console.log('🔄 Dispositivos cambiados, reescaneando...');
                setTimeout(() => {
                    if (!currentDeviceId) {
                        findAndConnectCamera();
                    }
                }, 1000);
            });
        }

        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space') {
                e.preventDefault();
            }
            if (e.code === 'KeyM') toggleSound();
            if (e.code === 'KeyC') showCameraSelector();
        });

        window.addEventListener('beforeunload', () => {
            if (broadcastPeer) {
                broadcastPeer.destroy();
            }
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
            }
            stopAllSystems();
        });

        init();

        function toggleFullscreen() {
            const btn = document.getElementById('fullscreenBtn');
            if (!document.fullscreenElement && 
                !document.mozFullScreenElement && 
                !document.webkitFullscreenElement && 
                !document.msFullscreenElement) {
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen();
                } else if (document.documentElement.mozRequestFullScreen) {
                    document.documentElement.mozRequestFullScreen();
                } else if (document.documentElement.webkitRequestFullscreen) {
                    document.documentElement.webkitRequestFullscreen();
                } else if (document.documentElement.msRequestFullscreen) {
                    document.documentElement.msRequestFullscreen();
                }
                btn.innerHTML = '⛶';
                btn.title = 'Salir de Pantalla Completa';
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.mozCancelFullScreen) {
                    document.mozCancelFullScreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
                btn.innerHTML = '⛶';
                btn.title = 'Pantalla Completa';
            }
        }

        document.addEventListener('fullscreenchange', updateFullscreenIcon);
        document.addEventListener('webkitfullscreenchange', updateFullscreenIcon);
        document.addEventListener('mozfullscreenchange', updateFullscreenIcon);
        document.addEventListener('MSFullscreenChange', updateFullscreenIcon);

        function updateFullscreenIcon() {
            const btn = document.getElementById('fullscreenBtn');
            if (document.fullscreenElement || 
                document.webkitFullscreenElement || 
                document.mozFullScreenElement || 
                document.msFullscreenElement) {
                btn.innerHTML = '⛶';
                btn.title = 'Salir de Pantalla Completa';
            } else {
                btn.innerHTML = '⛶';
                btn.title = 'Pantalla Completa';
            }
        }
    </script>

    <button class="fullscreen-btn" id="fullscreenBtn" onclick="toggleFullscreen()" title="Pantalla Completa">
        ⛶
    </button>

